{
  "mcpServers": {
    "quarkus-agent": {
      "command": "jbang",
      "args": [
        "--quiet",
        "-Dquarkus.log.console.stderr=true",
        "quarkus-agent-mcp@quarkusio"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@context7/mcp-server",
        "--url",
        "https://mcp.context7.com/mcp",
        "--api-key",
        "${CONTEXT7_API_KEY}"
      ]
    }
  }
}
