# Copy to .env (gitignored) and fill in. Never commit real values.
#
# Anthropic API key for the autonomous loop (scripts/orchestrate.sh).
# Not needed if you authenticate Claude Code interactively via ~/.claude.
ANTHROPIC_API_KEY=

# context7 MCP key — consumed by .mcp.json as ${CONTEXT7_API_KEY}.
# Get one at https://context7.com. Rotate immediately if it ever lands in git.
CONTEXT7_API_KEY=
